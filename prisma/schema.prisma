// ============================================================================
// Voxen — Prisma schema
// ============================================================================
// Princípios:
//  - Cada user tem seu workspace (escopo por userId)
//  - Better Auth gerencia User/Session/Account/Verification (4 modelos)
//  - Secrets em Settings.valueEnc cifrados com master key (AES-256-GCM)
//  - Transcript tem plainText + searchVector (tsvector via trigger SQL)
//  - Sem pgvector — abordagem harness/Karpathy
// ============================================================================

generator client {
  // Novo generator `prisma-client` (v6.x) — output em `apps/web/prisma-generated/`,
  // evita o auto-install bug do `prisma-client-js` em workspaces pnpm e
  // garante resolução de `@prisma/client/runtime/library` (que só fica em
  // `apps/web/node_modules/@prisma/client/` no pnpm workspace).
  // Output é gitignored (vide .gitignore).
  provider        = "prisma-client"
  output          = "../apps/web/prisma-generated"
  moduleFormat    = "esm"
  runtime         = "nodejs"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTH (better-auth + workflow de aprovação)
// ============================================================================

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id                            String                         @id @default(cuid())
  email                         String                         @unique
  emailVerified                 Boolean                        @default(false)
  name                          String
  image                         String?
  // Voxen-specific
  status                        UserStatus                     @default(PENDING)
  role                          UserRole                       @default(USER)
  // UI theme: linear (default) | zinc | emerald | light
  theme                         String                         @default("linear")
  // Desktop shell preference: classic (default) | focus
  interfaceMode                 String                         @default("classic")
  monthlyBudgetUsd              Decimal?                       @db.Decimal(10, 4) // null = sem limite
  approvedAt                    DateTime?
  approvedBy                    String?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  // Relations
  sessions                      Session[]
  accounts                      Account[]
  transcripts                   Transcript[]
  savedMedia                    SavedMedia[]
  jobs                          Job[]
  sourceContentVersions         SourceContentVersion[]
  researchArtifacts             ResearchArtifact[]
  transcriptEnrichments         TranscriptEnrichment[]
  transcriptCorrectionRevisions TranscriptCorrectionRevision[]
  interestEvents                InterestEvent[]
  interestProjections           InterestProjection[]
  costEvents                    CostEvent[]
  conversations                 Conversation[]
  chatApprovals                 ChatApproval[]
  chatTurns                     ChatTurn[]
  chatStreamLease               ChatStreamLease?
  notes                         Note[]
  noteRevisions                 NoteRevision[]
  libraryFolders                LibraryFolder[]
  brainNodes                    BrainNode[]
  brainEdges                    BrainEdge[]
  brainSources                  BrainSource[]
  brainFacts                    BrainFact[]
  brainEntityAliases            BrainEntityAlias[]
  brainCompilations             BrainCompilation[]
  telegramLink                  TelegramLink?
  automations                   Automation[]
  automationRuns                AutomationRun[]
  tags                          Tag[]
  mcpTokens                     McpToken[]
  oauthClients                  OauthClient[]
  oauthRefreshTokens            OauthRefreshToken[]
  oauthAccessTokens             OauthAccessToken[]
  oauthConsents                 OauthConsent[]
  configRevisions               ConfigRevision[]               @relation("ConfigRevisionActor")

  @@index([status])
  @@index([role])
}

// Vínculo Telegram chat_id ↔ Voxen userId.
// Setup feito via código de 6 dígitos gerado em /conta → user envia /start
// <código> no bot → worker resolve e cria o link.
model TelegramLink {
  id       String   @id @default(cuid())
  userId   String   @unique
  chatId   BigInt   @unique
  username String?
  linkedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

model Session {
  id                 String              @id @default(cuid())
  token              String              @unique
  userId             String
  expiresAt          DateTime
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Provedor OIDC global da instância. `oidcConfig` contém o envelope
// AES-256-GCM completo; o adapter de autenticação o abre apenas em memória.
// `userId` registra quem criou a configuração, mas não define propriedade e
// não possui FK de propósito: excluir um admin não pode excluir o SSO global.
model SsoProvider {
  id             String    @id @default(cuid())
  providerId     String    @unique
  issuer         String
  domain         String
  domainVerified Boolean   @default(false)
  oidcConfig     String?   @db.Text
  samlConfig     String?   @db.Text
  userId         String
  organizationId String?
  disabledAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([domainVerified, disabledAt])
}

// ============================================================================
// SETTINGS (cifrado com master key)
// ============================================================================

enum SettingScope {
  GLOBAL
  USER
}

model Setting {
  id        String       @id @default(cuid())
  scope     SettingScope
  userId    String? // null se scope=GLOBAL
  key       String
  // valueEnc é AES-256-GCM(plaintext, master_key) em base64
  // formato: <iv_base64>.<ciphertext_base64>.<tag_base64>
  valueEnc  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([scope, userId, key])
  @@index([scope, key])
}

// Credencial individual do servidor MCP. O valor Bearer nunca é guardado: a
// coluna tokenHash contém SHA-256 do segredo exibido apenas na criação.
model McpToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  label      String
  // CSV canônico de READ,WRITE para evitar enum-array e manter a migration
  // compatível com instalações já existentes.
  scopes     String    @default("READ")
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// OAuth 2.1 provider state for remote MCP clients. Better Auth addresses these
// Prisma delegates as oauthClient/oauthRefreshToken/oauthAccessToken/oauthConsent.
model Jwks {
  id         String    @id @default(cuid())
  publicKey  String    @db.Text
  privateKey String    @db.Text
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
}

model OauthClient {
  id                      String              @id @default(cuid())
  clientId                String              @unique
  clientSecret            String?
  disabled                Boolean?            @default(false)
  skipConsent             Boolean?
  enableEndSession        Boolean?
  subjectType             String?
  scopes                  String[]            @default([])
  userId                  String?
  createdAt               DateTime?           @default(now())
  updatedAt               DateTime?           @updatedAt
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[]            @default([])
  tos                     String?
  policy                  String?
  softwareId              String?
  softwareVersion         String?
  softwareStatement       String?
  redirectUris            String[]            @default([])
  postLogoutRedirectUris  String[]            @default([])
  tokenEndpointAuthMethod String?
  grantTypes              String[]            @default([])
  responseTypes           String[]            @default([])
  public                  Boolean?
  type                    String?
  requirePKCE             Boolean?            @default(true)
  referenceId             String?
  metadata                Json?
  user                    User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens      OauthRefreshToken[]
  oauthAccessTokens       OauthAccessToken[]
  oauthConsents           OauthConsent[]

  @@index([userId])
  @@index([disabled])
}

model OauthRefreshToken {
  id                String             @id @default(cuid())
  token             String             @unique
  clientId          String
  sessionId         String?
  userId            String
  referenceId       String?
  expiresAt         DateTime?
  createdAt         DateTime?          @default(now())
  revoked           DateTime?
  authTime          DateTime?
  scopes            String[]           @default([])
  oauthClient       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session           Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAccessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
}

model OauthAccessToken {
  id                String             @id @default(cuid())
  token             String?            @unique
  clientId          String
  sessionId         String?
  userId            String?
  referenceId       String?
  refreshId         String?
  expiresAt         DateTime?
  createdAt         DateTime?          @default(now())
  scopes            String[]           @default([])
  oauthClient       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session           Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshToken OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
}

model OauthConsent {
  id          String      @id @default(cuid())
  clientId    String
  userId      String?
  referenceId String?
  scopes      String[]    @default([])
  createdAt   DateTime?   @default(now())
  updatedAt   DateTime?   @updatedAt
  oauthClient OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
}

// Eventos sanitizados de autorização. Não há FKs de propósito: exclusão de
// usuário ou cliente não apaga o histórico operacional da instância.
model McpOauthAuditEvent {
  id           String   @id @default(cuid())
  event        String
  outcome      String
  actorUserId  String?
  targetUserId String?
  clientId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([event, createdAt])
  @@index([clientId, createdAt])
  @@index([targetUserId, createdAt])
}

// Short-lived denylist for revoked OAuth JWTs. Only the random signed `jti` is
// persisted, and rows stop affecting access when the JWT expires. There are
// intentionally no FKs: deleting a user/client must never restore a token.
model McpOauthRevokedAccessToken {
  id        String   @id @default(cuid())
  tokenId   String   @unique
  clientId  String
  userId    String
  expiresAt DateTime
  revokedAt DateTime @default(now())

  @@index([expiresAt])
  @@index([clientId, revokedAt])
  @@index([userId, revokedAt])
}

// Histórico imutável das mudanças atômicas da configuração global. Segredos
// nunca são copiados para ConfigRevisionChange; o flag isSecret permite
// auditar a mudança sem reexpor credenciais.
model ConfigRevision {
  id                    String                 @id @default(cuid())
  number                Int                    @unique
  // A baseline criada na migração descreve um estado já existente, não um
  // estado restaurável. Ela fica no histórico, mas nunca pode ser rollback.
  isBaseline            Boolean                @default(false)
  actorUserId           String?
  reason                String?                @db.VarChar(500)
  createdAt             DateTime               @default(now())
  actor                 User?                  @relation("ConfigRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  changes               ConfigRevisionChange[]
  jobs                  Job[]
  chatTurns             ChatTurn[]
  researchArtifacts     ResearchArtifact[]
  transcriptEnrichments TranscriptEnrichment[]

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

model ConfigRevisionChange {
  id            String         @id @default(cuid())
  revisionId    String
  key           String
  previousValue String?        @db.Text
  nextValue     String?        @db.Text
  isSecret      Boolean        @default(false)
  revision      ConfigRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, key])
  @@index([key])
}

enum ResearchArtifactType {
  BRIEFING
  FAQ
  STUDY_GUIDE
  TIMELINE
  MIND_MAP
}

// Derivado privado: conteúdo sintetizado nunca é usado como fonte de busca.
model ResearchArtifact {
  id                 String               @id @default(cuid())
  userId             String
  type               ResearchArtifactType
  title              String
  content            String               @db.Text
  citations          Json                 @default("[]")
  scope              Json                 @default("{}")
  unavailableSources Json                 @default("[]")
  configRevisionId   String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  configRevision     ConfigRevision?      @relation(fields: [configRevisionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([configRevisionId])
}

// ============================================================================
// TRANSCRIPTS (corpo no Garage; texto + frontmatter espelhado aqui)
// ============================================================================

enum TranscriptSource {
  YOUTUBE
  INSTAGRAM
  TIKTOK
  X // x.com / twitter.com (yt-dlp suporta nativamente)
  WEB // página web (scraper Trafilatura)
  UPLOAD // arquivo de áudio/vídeo enviado pelo usuário
}

enum TranscriptionMethod {
  API // OpenRouter audio transcription
  SUBTITLES // baixou legendas oficiais
  SCRAPE // extração de página web via Trafilatura
  VISION // análise de imagem via modelo multimodal
  DOCUMENT // análise de documento via MarkItDown/OpenRouter PDF
  X_SEARCH // análise de post/thread do X via Grok/OpenRouter search
}

enum ContentStatus {
  ACTIVE
  ARCHIVED
  TRASH
}

enum InterestEventOrigin {
  OBSERVED
  EXPLICIT
}

enum InterestEventKind {
  TRANSCRIPT_VIEWED
  PREFERENCE_MORE
  PREFERENCE_LESS
  PREFERENCE_CLEARED
}

enum InterestProjectionHorizon {
  SHORT
  MEDIUM
  LONG
}

enum EnrichmentStatus {
  PENDING
  RUNNING
  COMPLETE
  RETRY
  SKIPPED
}

// Estado da última consulta à fonte externa. CHECKING/FAILED não tornam a
// versão já aceita inválida; deixam explícito que ela pode não ser a mais nova.
enum SourceRefreshStatus {
  CURRENT
  CHECKING
  FAILED
}

enum TranscriptCorrectionState {
  ACTIVE
  STALE
}

enum TranscriptCorrectionActor {
  USER
  MCP
  CHAT
  RESTORE
  SYSTEM
}

model Transcript {
  id                       String                         @id @default(cuid())
  userId                   String // == workspace_id
  folderId                 String?
  status                   ContentStatus                  @default(ACTIVE)
  source                   TranscriptSource
  url                      String
  title                    String
  channel                  String?
  author                   String?
  durationSec              Int
  publishedAt              DateTime?
  thumbnailUrl             String?
  originalObjectKey        String?
  originalFilename         String?
  originalMimeType         String?
  previewObjectKey         String?
  previewMimeType          String?
  language                 String // ISO 639-1
  transcriptionMethod      TranscriptionMethod
  model                    String? // null se SUBTITLES
  costUsd                  Decimal?                       @db.Decimal(10, 4)
  // .md no Garage (key relative ao bucket)
  mdPath                   String
  // Texto puro pra FTS (sem timestamps, sem frontmatter)
  plainText                String                         @db.Text
  // Resumo gerado pela IA em markdown (pode ser null se ainda não gerado)
  summaryMd                String?                        @db.Text
  // Validated derived Mermaid flow; it never replaces the canonical source.
  flowchartMd              String?                        @db.Text
  summaryStatus            EnrichmentStatus               @default(PENDING)
  summaryAttempts          Int                            @default(0)
  summaryStartedAt         DateTime?
  summaryNextAttemptAt     DateTime?
  summaryError             String?
  taggingStatus            EnrichmentStatus               @default(PENDING)
  taggingAttempts          Int                            @default(0)
  taggingStartedAt         DateTime?
  taggingNextAttemptAt     DateTime?
  taggingError             String?
  // Frontmatter como JSONB pra filtros estruturados
  frontmatter              Json
  // tsvector gerenciado por trigger SQL (ver migration). Não declarável em Prisma; usar Unsupported.
  searchVector             Unsupported("tsvector")?
  checksum                 String? // sha256 do áudio original
  // Proveniência versionada para fontes WEB. sourceVersion=0 identifica
  // conteúdo legado ainda sem snapshot; a primeira atualização o preserva.
  sourceChecksum           String?
  sourceVersion            Int                            @default(0)
  sourceCollectedAt        DateTime?
  sourceMetadata           Json                           @default("{}")
  sourceRefreshStatus      SourceRefreshStatus            @default(CURRENT)
  sourceRefreshError       String?                        @db.Text
  // Materialized correction overlay. Canonical mdPath/plainText stay untouched.
  correctionRevision       Int                            @default(0)
  correctedMarkdown        String?                        @db.Text
  correctedPlainText       String?                        @db.Text
  correctedChecksum        String?
  correctionSourceVersion  Int?
  correctionSourceChecksum String?
  correctionState          TranscriptCorrectionState      @default(ACTIVE)
  correctionStaleReason    String?                        @db.Text
  formatVersion            Int                            @default(1)
  archivedAt               DateTime?
  trashedAt                DateTime?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  // Relations
  user                     User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder                   LibraryFolder?                 @relation(fields: [folderId], references: [id], onDelete: SetNull)
  chunks                   Chunk[]
  job                      Job?
  sourceRefreshJobs        Job[]                          @relation("SourceRefreshJobs")
  sourceVersions           SourceContentVersion[]
  conversations            Conversation[]
  tags                     TranscriptTag[]
  noteSources              NoteTranscriptSource[]
  transcriptEnrichments    TranscriptEnrichment[]
  correctionRevisions      TranscriptCorrectionRevision[]
  interestEvents           InterestEvent[]
  brainCompilation         BrainCompilation?
  savedMedia               SavedMedia?
  // Índice GIN no tsvector criado via SQL na migration

  @@unique([id, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([userId, folderId])
  @@index([userId, source])
  @@index([userId, language])
  @@index([summaryStatus, summaryNextAttemptAt])
  @@index([taggingStatus, taggingNextAttemptAt])
  @@index([userId, sourceRefreshStatus])
}

model InterestEvent {
  id           String              @id @default(cuid())
  userId       String
  transcriptId String
  origin       InterestEventOrigin
  kind         InterestEventKind
  signal       Int
  dedupeKey    String?
  metadata     Json                @default("{}")
  occurredAt   DateTime            @default(now())
  createdAt    DateTime            @default(now())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript   Transcript          @relation(fields: [transcriptId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, transcriptId, occurredAt(sort: Desc)])
  @@index([userId, origin, occurredAt(sort: Desc)])
}

model InterestProjection {
  id               String                    @id @default(cuid())
  userId           String
  horizon          InterestProjectionHorizon
  algorithmVersion String
  windowDays       Int
  halfLifeDays     Int
  items            Json                      @default("[]")
  eventCount       Int                       @default(0)
  eventWatermark   DateTime?
  computedAt       DateTime                  @default(now())
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, horizon])
  @@index([userId, computedAt(sort: Desc)])
}

model TranscriptCorrectionRevision {
  id             String                    @id @default(cuid())
  userId         String
  transcriptId   String
  revision       Int
  sourceVersion  Int
  sourceChecksum String?
  markdown       String                    @db.Text
  plainText      String                    @db.Text
  checksum       String
  actor          TranscriptCorrectionActor
  operation      Json?
  changeSummary  String?                   @db.Text
  createdAt      DateTime                  @default(now())
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript     Transcript                @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, revision])
  @@index([userId, transcriptId, createdAt(sort: Desc)])
}

// Snapshot imutável de cada versão aceita de uma fonte externa. mdPath aponta
// para um objeto próprio quando há atualização, mantendo o conteúdo antigo
// recuperável mesmo depois de o Transcript passar a apontar para a versão nova.
model SourceContentVersion {
  id           String     @id @default(cuid())
  userId       String
  transcriptId String
  version      Int
  checksum     String
  mdPath       String
  plainText    String     @db.Text
  metadata     Json       @default("{}")
  collectedAt  DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, version])
  @@unique([transcriptId, checksum])
  @@index([userId, transcriptId, collectedAt(sort: Desc)])
}

// Pastas de biblioteca para organizar conteúdos transcritos/documentos/web.
// Não movem objetos no S3; são metadata de navegação e base para o Brain.
model LibraryFolder {
  id          String          @id @default(cuid())
  userId      String
  parentId    String?
  name        String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      LibraryFolder?  @relation("LibraryFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    LibraryFolder[] @relation("LibraryFolderTree")
  transcripts Transcript[]
  tag         Tag?            @relation("TagFolder")

  @@index([userId, parentId])
  @@index([userId, updatedAt(sort: Desc)])
}

// Tags geradas por IA (N:N com Transcript). Cada tag também "aponta" para uma
// LibraryFolder de mesmo nome (auto-criada), então tag e pasta convivem: a pasta
// segue como vínculo único de navegação/Brain, a tag como vínculo múltiplo de
// organização/busca. Dedup por (userId, slug). Ver spec 075.
model Tag {
  id          String          @id @default(cuid())
  userId      String
  name        String
  slug        String // normalizado: minúsculas, sem acento, [a-z0-9-]
  folderId    String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      LibraryFolder?  @relation("TagFolder", fields: [folderId], references: [id], onDelete: SetNull)
  transcripts TranscriptTag[]

  @@unique([userId, slug])
  @@index([userId, name])
}

// Join N:N entre Transcript e Tag.
model TranscriptTag {
  transcriptId String
  tagId        String
  createdAt    DateTime   @default(now())
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transcriptId, tagId])
  @@index([tagId])
}

// Opcional: chunks granulares pra busca por timestamp range / re-rank
// MVP pode viver só com Transcript.plainText. Manter modelo pra expansão futura.
model Chunk {
  id           String     @id @default(cuid())
  transcriptId String
  startSec     Int
  endSec       Int
  text         String     @db.Text
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, startSec])
}

// ============================================================================
// BRAIN — grafo de conhecimento Postgres-first
// ============================================================================

enum BrainSourceType {
  TRANSCRIPT
  NOTE
  FOLDER
  JOB
  CHAT
  MANUAL
  EXTERNAL_ENRICHMENT
}

enum BrainNodeType {
  CONTENT
  FOLDER
  ENTITY
  TOPIC
  CLAIM
  EVENT
  CLUSTER
}

enum BrainEdgeKind {
  BELONGS_TO
  LINKS_TO
  MENTIONS
  SUPPORTS
  CONTRADICTS
  SAME_AS
  PART_OF
  RELATED_TO
  NEXT_TO
}

enum BrainCompilationStatus {
  PENDING
  RUNNING
  RETRY
  PARTIAL
  COMPLETED
  FAILED
  SKIPPED
}

model BrainNode {
  id            String             @id @default(cuid())
  userId        String
  key           String
  type          BrainNodeType
  label         String
  description   String?            @db.Text
  status        ContentStatus      @default(ACTIVE)
  metadata      Json               @default("{}")
  sourceType    BrainSourceType?
  sourceId      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoing      BrainEdge[]        @relation("BrainEdgeFrom")
  incoming      BrainEdge[]        @relation("BrainEdgeTo")
  sources       BrainSource[]
  entityAliases BrainEntityAlias[]

  @@unique([userId, key])
  @@index([userId, type, updatedAt(sort: Desc)])
  @@index([userId, status, type])
  @@index([userId, sourceType, sourceId])
}

model BrainEdge {
  id         String        @id @default(cuid())
  userId     String
  fromNodeId String
  toNodeId   String
  kind       BrainEdgeKind
  confidence Decimal       @default(1) @db.Decimal(5, 4)
  method     String        @default("manual")
  status     ContentStatus @default(ACTIVE)
  metadata   Json          @default("{}")
  createdBy  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  from       BrainNode     @relation("BrainEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  to         BrainNode     @relation("BrainEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  sources    BrainSource[]
  facts      BrainFact[]

  @@unique([userId, fromNodeId, toNodeId, kind, method])
  @@index([userId, kind, updatedAt(sort: Desc)])
  @@index([userId, status, kind])
  @@index([fromNodeId])
  @@index([toNodeId])
}

model BrainSource {
  id            String          @id @default(cuid())
  userId        String
  nodeId        String?
  edgeId        String?
  factId        String?
  sourceType    BrainSourceType
  sourceId      String
  chunkId       String?
  startLine     Int?
  endLine       Int?
  startSec      Int?
  endSec        Int?
  segmentKey    String?
  evidenceKey   String?
  excerpt       String?         @db.Text
  invalidatedAt DateTime?       @db.Timestamptz(3)
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  node          BrainNode?      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  edge          BrainEdge?      @relation(fields: [edgeId], references: [id], onDelete: Cascade)
  fact          BrainFact?      @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@unique([userId, evidenceKey])
  @@index([userId, sourceType, sourceId])
  @@index([nodeId])
  @@index([edgeId])
  @@index([factId])
  @@index([userId, invalidatedAt])
}

// Versioned semantic meaning attached to a navigable BrainEdge. validFrom/
// validTo are domain time; observedAt/createdAt are knowledge/transaction time.
model BrainFact {
  id            String        @id @default(cuid())
  userId        String
  edgeId        String
  factKey       String
  predicate     String
  validFrom     DateTime?     @db.Timestamptz(3)
  validTo       DateTime?     @db.Timestamptz(3)
  observedAt    DateTime      @default(now()) @db.Timestamptz(3)
  invalidatedAt DateTime?     @db.Timestamptz(3)
  confidence    Decimal       @default(1) @db.Decimal(5, 4)
  method        String        @default("manual")
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  edge          BrainEdge     @relation(fields: [edgeId], references: [id], onDelete: Cascade)
  sources       BrainSource[]

  @@unique([userId, factKey])
  @@index([userId, validFrom, validTo])
  @@index([userId, invalidatedAt])
  @@index([userId, observedAt(sort: Desc)])
  @@index([edgeId])
}

// Alias observations are candidates, not destructive redirects. Several
// entities may legitimately share the same normalizedAlias inside one workspace.
model BrainEntityAlias {
  id              String          @id @default(cuid())
  userId          String
  entityNodeId    String
  alias           String
  normalizedAlias String
  entityType      String          @default("OTHER")
  confidence      Decimal         @default(1) @db.Decimal(5, 4)
  method          String          @default("manual")
  sourceType      BrainSourceType
  sourceId        String
  segmentKey      String?
  evidenceKey     String
  invalidatedAt   DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity          BrainNode       @relation(fields: [entityNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, evidenceKey])
  @@index([userId, normalizedAlias])
  @@index([userId, entityType, normalizedAlias])
  @@index([entityNodeId])
  @@index([userId, sourceType, sourceId])
  @@index([userId, invalidatedAt])
}

model BrainCompilation {
  id                String                    @id @default(cuid())
  userId            String
  transcriptId      String                    @unique
  contentHash       String
  status            BrainCompilationStatus    @default(PENDING)
  totalSegments     Int                       @default(0)
  completedSegments Int                       @default(0)
  lastError         String?                   @db.Text
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @default(now()) @updatedAt
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript        Transcript                @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  segments          BrainCompilationSegment[]

  @@index([userId, status, updatedAt(sort: Desc)])
}

model BrainCompilationSegment {
  id             String                 @id @default(cuid())
  compilationId  String
  segmentKey     String
  status         BrainCompilationStatus @default(PENDING)
  startLine      Int
  endLine        Int
  startSec       Int?
  endSec         Int?
  itemCount      Int                    @default(0)
  attempts       Int                    @default(0)
  error          String?                @db.Text
  claimedBy      String?
  claimedAt      DateTime?
  leaseExpiresAt DateTime?
  nextAttemptAt  DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @default(now()) @updatedAt
  compilation    BrainCompilation       @relation(fields: [compilationId], references: [id], onDelete: Cascade)

  @@unique([compilationId, segmentKey])
  @@index([compilationId, status])
  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

// ============================================================================
// JOBS (download + transcribe)
// ============================================================================

enum JobType {
  DOWNLOAD_MEDIA
  DOWNLOAD_AND_TRANSCRIBE
  SCRAPE_WEB
  UPLOAD_AND_TRANSCRIBE
  UPLOAD_AND_ANALYZE_IMAGE
  UPLOAD_AND_ANALYZE_DOCUMENT
  ANALYZE_X
  DELETE_KNOWLEDGE
}

enum KnowledgeDeletionTargetType {
  TRANSCRIPT
  NOTE
  SAVED_MEDIA
  LIBRARY_FOLDER
  TRANSCRIPT_ENRICHMENT
}

enum SavedMediaStatus {
  QUEUED
  DOWNLOADING
  READY
  PROCESSING
  PROCESSED
  DELETING
  FAILED
}

model SavedMedia {
  id           String           @id @default(uuid())
  userId       String
  sourceUrl    String
  canonicalUrl String
  title        String?
  channel      String?
  author       String?
  durationSec  Int?
  thumbnailUrl String?
  objectKey    String?
  filename     String?
  mimeType     String?
  byteSize     BigInt?
  status       SavedMediaStatus @default(QUEUED)
  errorMsg     String?
  transcriptId String?          @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  readyAt      DateTime?
  processedAt  DateTime?
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript   Transcript?      @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  jobs         Job[]

  @@unique([userId, canonicalUrl])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  COMPLETED_WITH_WARNINGS
  FAILED
  CANCELLED
}

model Job {
  id                  String                       @id @default(cuid())
  userId              String
  type                JobType
  status              JobStatus                    @default(QUEUED)
  sourceUrl           String
  transcriptId        String?                      @unique
  // Quando preenchido, SCRAPE_WEB atualiza este conteúdo existente em vez de
  // criar um novo Transcript. O resultado continua em transcriptId.
  refreshTranscriptId String?
  savedMediaId        String?
  deletionTargetType  KnowledgeDeletionTargetType?
  deletionTargetId    String?
  deletionTargetTitle String?
  configRevisionId    String?
  errorMsg            String?
  progressStage       String?
  progressPercent     Int?
  progressedAt        DateTime?
  workerId            String?
  attempt             Int                          @default(0)
  heartbeatAt         DateTime?
  leaseExpiresAt      DateTime?
  queuedAt            DateTime                     @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript          Transcript?                  @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  refreshTranscript   Transcript?                  @relation("SourceRefreshJobs", fields: [refreshTranscriptId], references: [id], onDelete: SetNull)
  savedMedia          SavedMedia?                  @relation(fields: [savedMediaId], references: [id], onDelete: SetNull)
  configRevision      ConfigRevision?              @relation(fields: [configRevisionId], references: [id], onDelete: SetNull)
  progressEvents      JobProgressEvent[]

  @@index([userId, queuedAt(sort: Desc)])
  @@index([userId, progressedAt(sort: Desc)])
  @@index([status])
  @@index([status, leaseExpiresAt])
  @@index([configRevisionId])
  @@index([userId, refreshTranscriptId, status])
  @@index([userId, savedMediaId, status])
  @@index([userId, deletionTargetType, deletionTargetId, status])
}

model JobProgressEvent {
  id           String   @id @default(cuid())
  jobId        String
  userId       String
  stage        String
  percent      Int?
  chunkIndex   Int?
  transcriptId String?
  errorMsg     String?
  createdAt    DateTime @default(now())
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([userId, createdAt])
}

// ============================================================================
// COST EVENTS (painel de custos)
// ============================================================================

enum CostEventKind {
  CHAT
  WEB_SEARCH
  TRANSCRIBE
  DOCUMENT
  X_SEARCH
  EMBED // não usado no MVP (sem embeddings), mas reservado
}

model CostEvent {
  id        String        @id @default(cuid())
  userId    String
  ts        DateTime      @default(now())
  kind      CostEventKind
  model     String
  tokensIn  Int           @default(0)
  tokensOut Int           @default(0)
  costUsd   Decimal       @db.Decimal(10, 6)
  jobId     String?
  meta      Json?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, ts(sort: Desc)])
  @@index([ts])
  @@index([kind])
}

// Diagnósticos administrativos de falha por capacidade. Não armazena prompt,
// resposta, segredo ou conteúdo de workspace — só o resultado seguro do probe.
model AiCapabilityCheck {
  id           String   @id @default(cuid())
  capability   String
  model        String
  success      Boolean
  errorMessage String?
  latencyMs    Int?
  checkedAt    DateTime @default(now())

  @@index([capability, success, checkedAt(sort: Desc)])
}

// ============================================================================
// CHAT (conversas persistidas)
// ============================================================================

model Conversation {
  id                 String               @id @default(cuid())
  // Uma linha do tempo canônica por workspace. Contextos de transcrição
  // entram como referências/mensagens, nunca como outra sessão.
  userId             String               @unique
  title              String               @default("Vox")
  thinking           Boolean              @default(false)
  // Conversa contextual de uma transcrição (chat por transcrição). Null = chat
  // geral. SetNull no delete da transcrição: a conversa sobrevive como geral.
  transcriptId       String?
  archivedAt         DateTime?
  // Quantas vezes a conversa já foi compactada. Útil pra debug + UI exibir
  // "compactada N vezes" quando relevante.
  compactionCount    Int                  @default(0)
  // Folha da trilha ativa (spec 127). A conversa é uma ÁRVORE: versionar uma
  // mensagem cria um ramo irmão, e este ponteiro diz qual ramo está em uso.
  // Null = conversa nunca ramificada; a trilha é a linha do tempo inteira.
  //
  // Sem chave estrangeira de propósito: Conversation -> ChatMessage ->
  // Conversation fecharia um ciclo de relação no Prisma só para garantir algo
  // que a leitura já trata — ponteiro pendurado cai na última mensagem
  // (`resolveActiveTrail`), e `clearConversation` zera o ponteiro na mesma
  // transação que apaga as mensagens.
  activeLeafId       String?
  // A conversa já é uma árvore de verdade (spec 127): toda mensagem exceto a
  // raiz tem antecessor registrado. Marcada na primeira escrita estrutural.
  //
  // Precisa ser explícito, não inferido de "quantas mensagens estão sem
  // antecessor": com inferência, versionar a PRIMEIRA mensagem cria uma
  // segunda raiz legítima e a leitura confundiria isso com dados legados —
  // prependendo a versão abandonada no histórico enviado ao modelo.
  messagesLinearized Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript         Transcript?          @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  messages           ChatMessage[]
  approvals          ChatApproval[]
  turns              ChatTurn[]
  compactionLease    ChatCompactionLease?

  @@index([updatedAt(sort: Desc)])
  @@index([transcriptId])
}

enum ChatApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model ChatApproval {
  id                 String             @id @default(cuid())
  userId             String
  conversationId     String
  providerApprovalId String
  action             String
  payload            Json
  status             ChatApprovalStatus @default(PENDING)
  /// Null = no wall-clock TTL (spec 090). Legacy rows may still have a timestamp.
  expiresAt          DateTime?
  createdAt          DateTime           @default(now())
  decidedAt          DateTime?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation       Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, providerApprovalId])
  @@index([userId, status, expiresAt])
  @@index([conversationId, createdAt])
}

model ChatCompactionLease {
  conversationId String       @id
  ownerId        String
  expiresAt      DateTime
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ChatStreamLease {
  userId    String   @id
  ownerId   String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum ChatTurnStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

model ChatTurn {
  id                 String          @id @default(cuid())
  userId             String
  conversationId     String
  userMessageId      String          @unique
  assistantMessageId String          @unique
  configRevisionId   String?
  status             ChatTurnStatus  @default(PENDING)
  errorMsg           String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  finishedAt         DateTime?
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation       Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  configRevision     ConfigRevision? @relation(fields: [configRevisionId], references: [id], onDelete: SetNull)

  @@index([userId, status, updatedAt])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@index([configRevisionId])
}

enum ChatRole {
  USER
  ASSISTANT
  // SYSTEM: mensagens auto-geradas pelo Voxen (resumo de compactação,
  // resultado de job de automação, etc). Não foram digitadas pelo user
  // nem geradas pelo agente em resposta direta.
  SYSTEM
}

enum ChatMessageKind {
  NORMAL
  COMPACTION_SUMMARY
  HITL_RESPONSE
}

model ChatMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           ChatRole
  // NORMAL = mensagem regular do chat
  // COMPACTION_SUMMARY = mensagem-resumo que substitui um lote de mensagens
  //   antigas após compactação automática de memória. Tem role=SYSTEM.
  kind           ChatMessageKind @default(NORMAL)
  content        String          @db.Text
  // tools usadas pela resposta (array de {name, args, preview}) — JSONB
  tools          Json?
  // Linha do tempo visual do turno (raciocínio + grupos de tools). Nunca é
  // reenviada ao modelo; serve para restaurar a UI após reload.
  segments       Json?
  // Evidências estruturadas extraídas exclusivamente de verify_citations.
  // Mensagens legadas permanecem null e degradam sem selo de verificação.
  citations      Json?
  // Anexos vinculados à mensagem do usuário (array de {jobId, name, kind}) —
  // JSONB. Preenchido pelo servidor a partir de jobs de upload do PRÓPRIO
  // usuário; nunca copiado cru do payload do cliente (spec 126).
  attachments    Json?
  // Quando setado, esta mensagem foi "compactada" — significa que seu
  // conteúdo já foi substituído por uma COMPACTION_SUMMARY mais recente.
  // Fica no DB pra histórico (user pode expandir e ver), mas NÃO é enviada
  // mais no contexto da próxima chamada ao modelo.
  compactedAt    DateTime?
  // Antecessor na árvore da conversa (spec 127). A trilha exibida e enviada ao
  // modelo é a caminhada da folha ativa até a raiz — numa árvore, `createdAt`
  // deixa de definir a sequência, porque uma versão criada depois pode estar
  // acima na trilha.
  //
  // Null significa raiz OU mensagem anterior ao versionamento. Os dados legados
  // fica todo nulo e continua legível como trilha linear contínua, sem
  // migração de dados obrigatória.
  parentId       String?
  createdAt      DateTime        @default(now())
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent         ChatMessage?    @relation("ChatMessageBranch", fields: [parentId], references: [id], onDelete: SetNull)
  children       ChatMessage[]   @relation("ChatMessageBranch")

  @@index([conversationId, createdAt])
  @@index([conversationId, compactedAt])
  @@index([conversationId, parentId])
}

// ============================================================================
// NOTES — KB manual escrita pelo user ou pela Vox (via tools)
// ============================================================================
// Estrutura em árvore: kind=FOLDER agrupa, kind=NOTE tem conteúdo markdown.
// FTS via tsvector na coluna `searchVector` (mantida por trigger SQL).

enum NoteKind {
  NOTE
  FOLDER
}

enum NoteRevisionActor {
  USER
  MCP
  CHAT
  RESTORE
  SYSTEM
}

model Note {
  id                String                   @id @default(cuid())
  userId            String
  parentId          String?
  sourceType        BrainSourceType?
  sourceId          String?
  kind              NoteKind                 @default(NOTE)
  title             String
  // Conteúdo markdown. FOLDER ignora este campo.
  content           String                   @default("") @db.Text
  revision          Int                      @default(1)
  // tsvector mantido por trigger SQL (sync com title+content).
  searchVector      Unsupported("tsvector")?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @default(now()) @updatedAt
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent            Note?                    @relation("NoteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Note[]                   @relation("NoteTree")
  transcriptSources NoteTranscriptSource[]
  revisions         NoteRevision[]

  @@index([userId, parentId])
  @@index([userId, sourceType, sourceId])
  @@index([userId, updatedAt(sort: Desc)])
}

model NoteRevision {
  id            String            @id @default(cuid())
  userId        String
  noteId        String
  revision      Int
  title         String
  content       String            @db.Text
  checksum      String
  actor         NoteRevisionActor
  changeSummary String?           @db.Text
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  note          Note              @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, revision])
  @@index([userId, noteId, createdAt(sort: Desc)])
}

// Fontes explícitas de uma nota. A coluna Note.sourceType/sourceId permanece
// como vínculo primário legado para compatibilidade; esta relação suporta uma
// nota curada sustentada por múltiplas transcrições.
model NoteTranscriptSource {
  noteId       String
  transcriptId String
  userId       String
  createdAt    DateTime               @default(now())
  note         Note                   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  transcript   Transcript             @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  anchors      NoteTranscriptAnchor[]

  @@id([noteId, transcriptId])
  @@index([userId, transcriptId])
}

enum NoteAnchorStatus {
  VALID
  STALE
  UNAVAILABLE
}

model NoteTranscriptAnchor {
  id             String               @id @default(cuid())
  noteId         String
  transcriptId   String
  userId         String
  startLine      Int?
  endLine        Int?
  startSec       Int?
  endSec         Int?
  selectedQuote  String               @db.Text
  quoteHash      String
  sourceVersion  Int                  @default(0)
  sourceChecksum String?
  status         NoteAnchorStatus     @default(VALID)
  staleReason    String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt
  source         NoteTranscriptSource @relation(fields: [noteId, transcriptId], references: [noteId, transcriptId], onDelete: Cascade)

  @@index([userId, transcriptId, status])
  @@index([noteId, transcriptId])
}

enum TranscriptEnrichmentType {
  WEB_RESEARCH
}

enum TranscriptEnrichmentStatus {
  PENDING
  RUNNING
  NO_RESEARCH_NEEDED
  READY
  RETRY
  FAILED
  CANCELLED
}

enum TranscriptEnrichmentReviewState {
  SUGGESTED
  ACCEPTED
  DISMISSED
}

enum TranscriptEnrichmentTrigger {
  AUTO
  MANUAL
  MCP
}

model TranscriptEnrichment {
  id                String                          @id @default(cuid())
  userId            String
  transcriptId      String
  configRevisionId  String?
  runKey            String
  type              TranscriptEnrichmentType        @default(WEB_RESEARCH)
  status            TranscriptEnrichmentStatus      @default(PENDING)
  reviewState       TranscriptEnrichmentReviewState @default(SUGGESTED)
  trigger           TranscriptEnrichmentTrigger
  title             String                          @default("")
  content           String                          @default("") @db.Text
  citations         Json                            @default("[]")
  queries           Json                            @default("[]")
  rationale         String?                         @db.Text
  noResearchReason  String?                         @db.Text
  sourceVersion     Int                             @default(0)
  sourceChecksum    String?
  model             String?
  costUsd           Decimal?                        @db.Decimal(10, 6)
  tokensIn          Int                             @default(0)
  tokensOut         Int                             @default(0)
  searchCallCount   Int                             @default(0)
  searchResultCount Int                             @default(0)
  attempt           Int                             @default(0)
  nextAttemptAt     DateTime?
  startedAt         DateTime?
  generatedAt       DateTime?
  checkedAt         DateTime?
  expiresAt         DateTime?
  acceptedAt        DateTime?
  dismissedAt       DateTime?
  editedAt          DateTime?
  cancelRequestedAt DateTime?
  staleReason       String?                         @db.Text
  lastError         String?                         @db.Text
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @default(now()) @updatedAt
  user              User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript        Transcript                      @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  configRevision    ConfigRevision?                 @relation(fields: [configRevisionId], references: [id], onDelete: SetNull)

  @@unique([userId, transcriptId, runKey])
  @@index([userId, transcriptId, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt, createdAt])
  @@index([userId, reviewState, updatedAt(sort: Desc)])
  @@index([configRevisionId])
}

// ============================================================================
// AUTOMAÇÕES (jobs periódicos com continuidade — spec .specs/008-automacoes.md)
// ============================================================================

enum AutomationType {
  PERIODIC_SUMMARY // resumo periódico (puxa transcrições/notas via tools)
  WEB_RESEARCH // pesquisa web sobre um tema e cria nota
}

enum AutomationFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum AutomationStatus {
  ACTIVE
  PAUSED
}

enum AutomationDelivery {
  IN_APP
  TELEGRAM
  BOTH
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Automation {
  id         String              @id @default(cuid())
  userId     String
  name       String
  type       AutomationType
  prompt     String              @db.Text
  frequency  AutomationFrequency
  hour       Int // 0-23 (no timezone do automation)
  minute     Int // 0-59
  dayOfWeek  Int? // 0=segunda..6=domingo (só WEEKLY)
  dayOfMonth Int? // 1-31 (só MONTHLY; clampa último dia do mês)
  timezone   String              @default("America/Sao_Paulo")
  delivery   AutomationDelivery  @default(IN_APP)
  status     AutomationStatus    @default(ACTIVE)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @default(now()) @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@index([userId])
  @@index([status, nextRunAt])
}

model AutomationRun {
  id           String              @id @default(cuid())
  automationId String
  userId       String // duplicado p/ scoping rápido em queries de tool
  status       AutomationRunStatus @default(PENDING)
  startedAt    DateTime?
  finishedAt   DateTime?
  outputMd     String?             @db.Text
  errorMessage String?             @db.Text
  tokensIn     Int                 @default(0)
  tokensOut    Int                 @default(0)
  costUsd      Decimal             @default(0) @db.Decimal(12, 6)
  noteId       String? // se WEB_RESEARCH criou nota
  telegramSent Boolean             @default(false)
  triggeredBy  String              @default("scheduler") // scheduler | manual
  createdAt    DateTime            @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}
