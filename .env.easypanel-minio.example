# ============================================================================
# Voxen — template de env pra deploy Easypanel + MinIO externo
# ============================================================================
# Copie pra Easypanel UI → Environment do serviço Voxen, ou pra .env de
# instalação manual. Gere TODOS os secrets com: openssl rand -base64 32
#
# Guia visual: docs/DEPLOY.md → seção "Easypanel + MinIO externo"
# ============================================================================

# === Infraestrutura básica ===
APP_BASE_URL=https://voxen.seudominio.com
NODE_ENV=production

# Auth (better-auth) — secret de assinatura de sessões
BETTER_AUTH_SECRET=__GERE_COM_openssl_rand_base64_32__

# === Postgres + Redis (internos do compose) ===
POSTGRES_PASSWORD=__GERE_openssl_rand_base64_32__
REDIS_PASSWORD=__GERE_openssl_rand_base64_32__

# === Storage S3 (MinIO no Easypanel) ===
# URL interna do Easypanel — formato: http://<projeto>_minio:9000
# Verifique no painel do MinIO no Easypanel a URL exata.
S3_ENDPOINT=http://__SEU_PROJETO__-minio:9000
S3_ACCESS_KEY=__access_key_do_MinIO__
S3_SECRET_KEY=__secret_key_do_MinIO__
S3_BUCKET=voxen-transcripts
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# === Garage (DEIXAR vazio se usando S3 externo — backend prefere S3_*) ===
# Esses ficam aqui só pra evitar erros do init container do compose.
# Se você removeu os serviços `garage` e `garage-init` do compose, pode
# omitir essas vars.
GARAGE_RPC_SECRET=__openssl_rand_hex_32__
GARAGE_ADMIN_TOKEN=__openssl_rand_base64_32__

# === Master key (gerada automaticamente no primeiro boot) ===
# NÃO copie — o init container cria em /data/master.key e persiste no
# volume `master_key`. Sem ela, secrets cifrados ficam inacessíveis.
# Configure backup do volume `master_key` no Easypanel.

# === Build args (opcional — Easypanel preenche via tag/branch) ===
# VOXEN_VERSION=1.0.0
# VOXEN_GIT_SHA=__sha_curto__
# VOXEN_BUILT_AT=__iso_timestamp__
