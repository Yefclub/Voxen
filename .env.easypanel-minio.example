# ============================================================================
# Voxen — template de env pra deploy Easypanel + MinIO externo
# ============================================================================
# Copie pra Easypanel UI → Environment do App Voxen. Gere os secrets com:
#   openssl rand -base64 32
#
# Guia visual: docs/DEPLOY.md → seção "Easypanel App"
# ============================================================================

# === Infraestrutura básica ===
APP_BASE_URL=https://voxen.seudominio.com
NODE_ENV=production

# Auth (better-auth) — secret de assinatura de sessões
BETTER_AUTH_SECRET=__GERE_COM_openssl_rand_base64_32__

# Master key AES-256-GCM — base64 de 32 bytes. NÃO perca esse valor.
MASTER_KEY=__GERE_COM_openssl_rand_base64_32__

# === Postgres + Redis (serviços Easypanel separados) ===
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
REDIS_URL=redis://:PASSWORD@HOST:6379/0

# === Storage S3 (MinIO no Easypanel) ===
# URL interna do Easypanel — formato: http://<projeto>_minio:9000
# Verifique no painel do MinIO no Easypanel a URL exata.
S3_ENDPOINT=http://__SEU_PROJETO__-minio:9000
S3_ACCESS_KEY=__access_key_do_MinIO__
S3_SECRET_KEY=__secret_key_do_MinIO__
S3_BUCKET=voxen-transcripts
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# === Build args (opcional — Easypanel preenche via tag/branch) ===
# VOXEN_VERSION=1.0.0
# VOXEN_GIT_SHA=__sha_curto__
# VOXEN_BUILT_AT=__iso_timestamp__
