{
  "name": "@voxen/web",
  "version": "0.14.5-dev.1786366281",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --hot src/index.ts",
    "dev:client": "vite",
    "build": "if [ -f ../extension/package.sh ]; then bash ../extension/package.sh; fi && vite build",
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:extension": "bun test ../extension/tests",
    "package:extension": "bash ../extension/package.sh",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
