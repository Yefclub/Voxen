# voxen-proxy-agent — variáveis de ambiente
#
# Copie para .env e preencha com os valores que a UI admin do Voxen fornece.
# NUNCA versione o .env preenchido (contém o token).

# --- Obrigatórias ------------------------------------------------------------

# URL de controle do túnel (TLS/wss obrigatório). Fornecida pela UI admin.
VOXEN_TUNNEL_URL=https://tunnel.exemplo.com

# Token de conexão gerado na UI admin do Voxen. Mostrado uma única vez.
VOXEN_TUNNEL_TOKEN=cole-o-token-aqui

# --- Opcionais ---------------------------------------------------------------

# Fingerprint do server pra host-key pinning (fortemente recomendado).
# Fornecido pela UI admin junto com a URL.
# VOXEN_TUNNEL_FINGERPRINT=

# Remote reverso exposto na VPS. Deve casar com o authfile do server.
# VOXEN_SOCKS_REMOTE=R:1080:socks

# Ajustes finos de conexão (defaults sãos já aplicados).
# VOXEN_KEEPALIVE=25s
# VOXEN_MAX_RETRY_INTERVAL=30s
# VOXEN_AUTH_USER=voxen
