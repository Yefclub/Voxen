# ============================================================================
# Voxen — variáveis de ambiente
# ============================================================================
# REGRA: env só na raiz, nunca em apps/*. Tudo que NÃO está aqui está em DB
# (cifrado com master key; no Compose local ela é auto-gerada em /data/master.key).
#
# Em dev: NÃO precisa preencher nada — defaults do compose funcionam.
# Em prod (Easypanel): TROCAR os secrets abaixo por valores fortes.
# ============================================================================

# --- App ---
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# --- Postgres ---
POSTGRES_DB=voxen
POSTGRES_USER=voxen
POSTGRES_PASSWORD=dev_change_me_in_prod

# --- Redis ---
REDIS_PASSWORD=dev_change_me_in_prod
# URL completa (host + port + auth). No compose já vem montada.
REDIS_URL=redis://:dev_change_me_in_prod@redis:6379

# --- Storage S3-compatível ---
# Voxen usa Garage S3 self-hosted POR PADRÃO (sobe junto no compose).
# Você PODE trocar pra MinIO, AWS S3 ou qualquer S3-compatível — basta
# definir as variáveis S3_* abaixo (têm precedência sobre GARAGE_*).
#
# Exemplo MinIO externo:
#   S3_ENDPOINT=https://minio.exemplo.com:9000
#   S3_ACCESS_KEY=minioadmin
#   S3_SECRET_KEY=minioadmin_change_me
#   S3_BUCKET=voxen-transcripts
#   S3_REGION=us-east-1
#   S3_FORCE_PATH_STYLE=true   # MinIO normalmente exige path-style
#
# Exemplo AWS S3:
#   S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
#   S3_ACCESS_KEY=AKIA...
#   S3_SECRET_KEY=...
#   S3_BUCKET=meu-bucket
#   S3_REGION=us-east-1
#   S3_FORCE_PATH_STYLE=false
#
# Se nenhuma S3_* for definida, cai pra Garage local (settings abaixo).
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=
# S3_FORCE_PATH_STYLE=true

# --- Garage S3 (default) ---
GARAGE_RPC_SECRET=dev_change_me_in_prod_64_hex_chars
GARAGE_ADMIN_TOKEN=dev_change_me_in_prod
GARAGE_BUCKET=voxen-transcripts
# Endpoint S3-API do Garage (interno na rede docker). aioboto3 usa.
GARAGE_ENDPOINT=http://garage:3900
GARAGE_REGION=garage
# Geradas pelo scripts/garage-init.sh no primeiro boot e gravadas em /creds/voxen.env;
# o compose injeta no worker e no chat via env_file.
GARAGE_ACCESS_KEY=set_at_runtime_by_garage_init
GARAGE_SECRET_KEY=set_at_runtime_by_garage_init

# --- Better Auth ---
# Usado p/ assinar cookies de sessão. Gere com: openssl rand -base64 32
# Mínimo 32 chars (validado em runtime, vide apps/web/src/lib/auth.ts)
BETTER_AUTH_SECRET=dev_change_me_in_prod_must_be_at_least_32_chars_long_yes

# --- Master key (AES-256-GCM) ---
# Easypanel App/prod: gere com `openssl rand -base64 32` e defina MASTER_KEY.
# Compose local: mantém fallback por arquivo auto-gerado em /data/master.key.
# MASTER_KEY=
MASTER_KEY_PATH=/data/master.key

# ============================================================================
# Os itens abaixo NÃO ficam aqui — são configurados pelo admin na tela de setup
# inicial e armazenados cifrados na tabela `settings`:
#   - OPENROUTER_API_KEY
#   - DEFAULT_CHAT_MODEL
#   - DEFAULT_TRANSCRIPTION_MODEL
#   - SMTP_* (opcional, p/ avisar admin de novo cadastro)
# ============================================================================
