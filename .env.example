# ============================================================================
# Voxen — variáveis de ambiente
# ============================================================================
# REGRA: env só na raiz, nunca em apps/*. Tudo que NÃO está aqui está em DB
# (cifrado com MASTER_KEY).
#
# Em dev: `make dev` cria/completa .env automaticamente se necessário.
# Em prod/Easypanel: TROCAR os secrets abaixo por valores fortes.
# ============================================================================

# --- App ---
APP_BASE_URL=http://localhost:3000
# Opcional: origens extras aceitas pelo Better Auth, separadas por vírgula.
# Útil quando o Easypanel expõe domínio temporário e domínio final ao mesmo tempo.
BETTER_AUTH_TRUSTED_ORIGINS=
NODE_ENV=development

# --- Postgres ---
POSTGRES_DB=voxen
POSTGRES_USER=voxen
POSTGRES_PASSWORD=dev_change_me_in_prod

# --- Redis ---
REDIS_PASSWORD=dev_change_me_in_prod
# URL completa (host + port + auth). No compose já vem montada.
REDIS_URL=redis://:dev_change_me_in_prod@redis:6379

# --- Storage (default for new single-host installs) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/storage
# Maximum size for one remote item saved through /downloads (default: 2 GiB).
SAVED_MEDIA_MAX_BYTES=2147483648
# To use external S3/MinIO, merge .env.s3.example into this file and set
# STORAGE_DRIVER=s3. Existing S3 installs are never switched implicitly.

# --- Better Auth ---
# Usado p/ assinar cookies de sessão. Gere com: openssl rand -base64 32
# Mínimo 32 chars (validado em runtime, vide apps/web/src/lib/auth.ts)
BETTER_AUTH_SECRET=dev_change_me_in_prod_must_be_at_least_32_chars_long_yes

# --- Master key (AES-256-GCM) ---
# Base64 de 32 bytes. Gere em prod com: openssl rand -base64 32
# NÃO perca esse valor: ele decifra secrets salvos no banco.
MASTER_KEY=dm94ZW5fZGV2X21hc3Rlcl9rZXlfMzJfYnl0ZXMhISE=

# ============================================================================
# Os itens abaixo NÃO ficam aqui — são configurados pelo admin na tela de setup
# inicial e armazenados cifrados na tabela `settings`:
#   - OPENROUTER_API_KEY
#   - DEFAULT_CHAT_MODEL
#   - DEFAULT_TRANSCRIPTION_MODEL
#   - SMTP_* (opcional, p/ avisar admin de novo cadastro)
# ============================================================================

# --- Extração de mídia avançada (opcional) ---
# URL de um provider HTTP bgutil para PO tokens do yt-dlp.
# Use apenas provider controlado por você. Vazio = modo padrão do yt-dlp.
# Exemplo em rede Docker: http://bgutil-provider:4416
YTDLP_BGUTIL_BASE_URL=

# --- Memória conversacional experimental (opcional; desativada por padrão) ---
# Consulte docs/MEM0-SHADOW.md antes de ativar. O Mem0 roda separadamente e suas
# memórias nunca entram no prompt, Brain, MCP ou citações neste estágio.
VOXEN_MEMORY_PROVIDER=disabled
# MEM0_BASE_URL=https://mem0.internal.example
# MEM0_API_KEY=m0sk_replace_with_a_dedicated_key
# Immutable after first use; back it up before enabling shadow mode.
# MEM0_SCOPE_SECRET=replace_with_at_least_32_random_characters
# MEM0_DEPLOYMENT_VERSION=mem0-api-server@sha256:replace_with_pinned_digest
# MEM0_EXTRACTION_MODEL=provider/model-configured-in-mem0
# MEM0_RETENTION_DAYS=30
# MEM0_REQUEST_TIMEOUT_MS=5000
# MEM0_ALLOW_INSECURE_HTTP=false
